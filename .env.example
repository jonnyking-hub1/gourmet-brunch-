# Supabase project URL and keys, from Project Settings > API Keys.
# Server-side only. Never prefix the secret key with NEXT_PUBLIC_.
# Legacy anon/service_role keys also work in the corresponding slots.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Used only by npm run setup:admin, after applying the SQL migration.
SUPABASE_ADMIN_EMAIL=virusiatechindustries@gmail.com

# Optional canonical origin without a trailing slash.
# Leave blank to use each request's origin (including preview deployments).
APP_ORIGIN=
